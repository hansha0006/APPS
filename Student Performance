import java.util.*;

class Student {
    int roll;
    String name;
    double[] marks = new double[3];
    double attendance;

    Student(int roll, String name, double m1, double m2, double m3, double attendance) {
        this.roll = roll;
        this.name = name;
        marks[0] = m1;
        marks[1] = m2;
        marks[2] = m3;
        this.attendance = attendance;
    }
}

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        Student[] s = new Student[5];
        double highest = 0;
        String top = "";

        for (int i = 0; i < 5; i++) {
            System.out.println("Enter Roll, Name, 3 Marks, Attendance:");
            s[i] = new Student(sc.nextInt(), sc.next(),
                    sc.nextDouble(), sc.nextDouble(),
                    sc.nextDouble(), sc.nextDouble());
        }

        for (Student x : s) {
            double total = 0;
            for (double m : x.marks)
                total += m;

            double avg = total / 3;
            String result = avg >= 50 ? "Pass" : "Fail";
            String scholarship = avg >= 75 && x.attendance >= 80
                    ? "Eligible" : "Not Eligible";
            String performance = avg >= 85 ? "Excellent" : "Good";

            System.out.println("\n" + x.name);
            System.out.println("Total: " + total);
            System.out.println("Average: " + avg);
            System.out.println("Result: " + result);
            System.out.println("Scholarship: " + scholarship);
            System.out.println("Performance: " + performance);

            if (avg > highest) {
                highest = avg;
                top = x.name;
            }
        }

        System.out.println("\nHighest Average: " + top);
    }
}
