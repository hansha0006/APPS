import javax.swing.*;
import java.awt.*;
import java.awt.event.*;

// MODEL
class EmployeeModel {

    String username = "admin";
    String password = "admin123";

    boolean login(String u, String p) {
        return username.equals(u) && password.equals(p);
    }

    boolean changePassword(String oldPass, String newPass,
                           String confirmPass) {

        if (!password.equals(oldPass))
            return false;

        if (!newPass.equals(confirmPass))
            return false;

        password = newPass;
        return true;
    }
}

// VIEW
class EmployeeView extends JFrame {

    JTextField username = new JTextField();
    JPasswordField password = new JPasswordField();

    JButton login = new JButton("Login");

    JMenuBar menuBar = new JMenuBar();

    JMenu employee = new JMenu("Employee");
    JMenu tools = new JMenu("Tools");
    JMenu exit = new JMenu("Exit");

    JMenuItem addEmployee = new JMenuItem("Add Employee");
    JMenuItem viewEmployee = new JMenuItem("View Employee");

    JMenuItem changePassword =
        new JMenuItem("Change Password");

    JMenuItem logout = new JMenuItem("Logout");
    JMenuItem exitApplication =
        new JMenuItem("Exit Application");

    EmployeeView() {

        setTitle("Employee Login");
        setSize(350, 200);

        setLayout(new GridLayout(3, 2));

        add(new JLabel("Username"));
        add(username);

        add(new JLabel("Password"));
        add(password);

        add(login);

        setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);
        setVisible(true);
    }

    void showMainWindow() {

        getContentPane().removeAll();

        employee.add(addEmployee);
        employee.add(viewEmployee);

        tools.add(changePassword);

        exit.add(logout);
        exit.add(exitApplication);

        menuBar.add(employee);
        menuBar.add(tools);
        menuBar.add(exit);

        setJMenuBar(menuBar);

        add(new JLabel("Employee Management Portal",
                SwingConstants.CENTER));

        revalidate();
        repaint();
    }
}

// CONTROLLER
class EmployeeController {

    EmployeeModel model;
    EmployeeView view;

    EmployeeController(EmployeeModel model,
                       EmployeeView view) {

        this.model = model;
        this.view = view;

        view.login.addActionListener(e -> login());

        view.addEmployee.addActionListener(e -> addEmployee());

        view.changePassword.addActionListener(
            e -> changePassword()
        );

        view.logout.addActionListener(e -> logout());

        view.exitApplication.addActionListener(
            e -> System.exit(0)
        );
    }

    void login() {

        String u = view.username.getText();

        String p = new String(view.password.getPassword());

        if (model.login(u, p)) {

            JOptionPane.showMessageDialog(
                view, "Login Successful");

            view.showMainWindow();

        } else {

            JOptionPane.showMessageDialog(
                view, "Invalid Username or Password");
        }
    }

    void addEmployee() {

        JTextField id = new JTextField();
        JTextField name = new JTextField();
        JTextField dept = new JTextField();

        Object[] fields = {
            "Employee ID:", id,
            "Employee Name:", name,
            "Department:", dept
        };

        JOptionPane.showConfirmDialog(
            view, fields, "Add Employee",
            JOptionPane.OK_CANCEL_OPTION
        );
    }

    void changePassword() {

        JPasswordField oldPass = new JPasswordField();
        JPasswordField newPass = new JPasswordField();
        JPasswordField confirmPass = new JPasswordField();

        Object[] fields = {
            "Old Password:", oldPass,
            "New Password:", newPass,
            "Confirm Password:", confirmPass
        };

        int option = JOptionPane.showConfirmDialog(
            view, fields, "Change Password",
            JOptionPane.OK_CANCEL_OPTION
        );

        if (option == JOptionPane.OK_OPTION) {

            boolean result = model.changePassword(
                new String(oldPass.getPassword()),
                new String(newPass.getPassword()),
                new String(confirmPass.getPassword())
            );

            if (result)
                JOptionPane.showMessageDialog(
                    view, "Password Changed Successfully");
            else
                JOptionPane.showMessageDialog(
                    view, "Password validation failed");
        }
    }

    void logout() {

        JOptionPane.showMessageDialog(
            view, "Logged out");

        view.dispose();

        new EmployeeController(
            new EmployeeModel(),
            new EmployeeView()
        );
    }
}

// MAIN
public class EmployeeManagementApp {

    public static void main(String[] args) {

        EmployeeModel model = new EmployeeModel();
        EmployeeView view = new EmployeeView();

        new EmployeeController(model, view);
    }
}
