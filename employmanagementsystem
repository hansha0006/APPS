class Employee {
    String name;
    int id;

    void display() {
        System.out.println("Employee Name: " + name);
        System.out.println("Employee ID: " + id);
    }

    public static void main(String[] args) {
        Employee e1 = new Employee();
        e1.name = "Rahul";
        e1.id = 101;

        Employee e2 = new Employee();
        e2.name = "Priya";
        e2.id = 102;

        e1.display();
        e2.display();
    }
}
