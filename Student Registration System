import javax.swing.*;

public class StudentRegistration {
    public static void main(String[] args) {

        JFrame frame = new JFrame("Student Registration");

        JLabel nameLabel = new JLabel("Name:");
        nameLabel.setBounds(30, 30, 100, 30);

        JTextField nameField = new JTextField();
        nameField.setBounds(120, 30, 200, 30);

        JLabel regLabel = new JLabel("Register No:");
        regLabel.setBounds(30, 70, 100, 30);

        JTextField regField = new JTextField();
        regField.setBounds(120, 70, 200, 30);

        JLabel genderLabel = new JLabel("Gender:");
        genderLabel.setBounds(30, 110, 100, 30);

        JRadioButton male = new JRadioButton("Male");
        male.setBounds(120, 110, 70, 30);

        JRadioButton female = new JRadioButton("Female");
        female.setBounds(190, 110, 80, 30);

        ButtonGroup group = new ButtonGroup();
        group.add(male);
        group.add(female);

        JLabel deptLabel = new JLabel("Department:");
        deptLabel.setBounds(30, 150, 100, 30);

        String[] departments = {"CSE", "ECE", "AIDS", "MECH"};
        JComboBox<String> dept = new JComboBox<>(departments);
        dept.setBounds(120, 150, 200, 30);

        JButton submit = new JButton("Submit");
        submit.setBounds(120, 200, 100, 30);

        submit.addActionListener(e -> {

            String gender = "";

            if (male.isSelected())
                gender = "Male";
            else if (female.isSelected())
                gender = "Female";

            JOptionPane.showMessageDialog(
                frame,
                "Name: " + nameField.getText()
                + "\nRegister No: " + regField.getText()
                + "\nGender: " + gender
                + "\nDepartment: " + dept.getSelectedItem()
            );
        });

        frame.add(nameLabel);
        frame.add(nameField);
        frame.add(regLabel);
        frame.add(regField);
        frame.add(genderLabel);
        frame.add(male);
        frame.add(female);
        frame.add(deptLabel);
        frame.add(dept);
        frame.add(submit);

        frame.setSize(400, 300);
        frame.setLayout(null);
        frame.setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);
        frame.setVisible(true);
    }
}
