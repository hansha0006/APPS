class Marks {
    int m1 = 80;
    int m2 = 75;
    int m3 = 90;

    void calculate() {
        int total = m1 + m2 + m3;
        double average = total / 3.0;

        System.out.println("Total Marks = " + total);
        System.out.println("Average Marks = " + average);
    }

    public static void main(String[] args) {
        Marks m = new Marks();
        m.calculate();
    }
}
